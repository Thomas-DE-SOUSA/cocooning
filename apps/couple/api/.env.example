# ==== HTTP ====
# Port the API listens on. Dev default: 3100 (3000 and 3001 are the usual Next.js and sibling ports).
PORT=3100

# ==== Logging ====
# Pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=debug
# true prints readable lines through pino-pretty (development only), false prints JSON.
LOG_PRETTY=true

# ==== Database ====
# Postgres 17 of the couple domain. Dev default: the local container of docs/guides/local-setup.md.
DATABASE_POSTGRES_URL=postgresql://cocooning:cocooning@localhost:5432/cocooning
# Longest time a transaction may run, in milliseconds.
DB_TX_TIMEOUT_MS=5000
# Longest wait for a pooled connection before a transaction starts, in milliseconds.
DB_TX_MAX_WAIT_MS=2000

# ==== File storage ====
# Root directory of the stored files, such as the instant photos (decision 0027). Relative to the API folder in
# development; a Docker volume in production. Dev default: .data/files (ignored by git).
FILE_STORAGE_DIRECTORY=.data/files

# ==== Authentication ====
# HS256 secret of the session JWT, at least 32 characters (decision 0034). Never commit a real one.
# Generate it with: openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-secret-replace-with-openssl-rand-base64-48
# Lifetime of a session from sign-in, in whole days (decision 0034, R4). Dev default: 90.
AUTH_SESSION_TTL_DAYS=90

# ==== Pairing ====
# Lifetime of an invitation code, in whole hours (decision 0028, R4). Dev default: 48.
PAIRING_INVITATION_CODE_TTL_HOURS=48

# ==== Messaging ====
# true runs the scheduled task that draws and issues the daily photo prompt every minute (R7); false stops it
# (the E2E tests drive it themselves). Dev default: true.
PHOTO_PROMPT_SCHEDULER_ENABLED=true
# true runs the outbox relay every five seconds: it reads the new events of the notes, the agenda and the messages
# and sends their Web Push notifications (R10, decision 0021); false stops it (the E2E tests drive it themselves).
# Dev default: true.
OUTBOX_RELAY_ENABLED=true
# VAPID key pair of the Web Push notifications (R11), base64url. Never commit a real pair: the values below are
# placeholders that start the API but cannot reach a phone. Generate a pair with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=BDevOnlyPlaceholderReplaceWithNpxWebPushGenerateVapidKeysAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
WEB_PUSH_VAPID_PRIVATE_KEY=DevOnlyPlaceholderReplaceWithYourOwnKeyAAAA
# Contact of the sender, sent to the push services: the https address of the PWA or a mailto. Apple refuses localhost.
# Dev default: a placeholder address.
WEB_PUSH_VAPID_SUBJECT=https://cocooning.example.com

# ==== Notes: smart folders (decision 0054) ====
# Our SearXNG search engine. Dev default: the local container of docs/guides/local-setup.md on port 8888.
WEB_SEARCH_SEARXNG_URL=http://localhost:8888
# Longest wait for one search and for each page read, in milliseconds. Dev default: 8000.
WEB_SEARCH_TIMEOUT_MS=8000
# Key of the free Gemini API that proposes the template of a smart folder and fills the cards. Never commit a real
# one. Create it on https://aistudio.google.com/apikey with the Google account of Cocooning. Left empty, the API
# starts but every proposal answers 503 and every card fails.
NOTE_CARD_GEMINI_API_KEY=
# Gemini model called through the Interactions API, without its Google Search tool. Dev default: gemini-3.5-flash-lite.
NOTE_CARD_GEMINI_MODEL=gemini-3.5-flash-lite
