# ==== HTTP ====
# Port the API listens on. Dev default: 3100 (3000 and 3001 are the usual Next.js and sibling ports).
PORT=3100

# ==== Logging ====
# Pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=debug
# true prints readable lines through pino-pretty (development only), false prints JSON.
LOG_PRETTY=true

# ==== Database ====
# Postgres 17 of the couple domain. Dev default: the local container of docs/guides/local-setup.md.
DATABASE_POSTGRES_URL=postgresql://cocooning:cocooning@localhost:5432/cocooning
# Longest time a transaction may run, in milliseconds.
DB_TX_TIMEOUT_MS=5000
# Longest wait for a pooled connection before a transaction starts, in milliseconds.
DB_TX_MAX_WAIT_MS=2000

# ==== File storage ====
# Root directory of the stored files, such as the instant photos (decision 0027). Relative to the API folder in
# development; a Docker volume in production. Dev default: .data/files (ignored by git).
FILE_STORAGE_DIRECTORY=.data/files

# ==== Authentication ====
# HS256 secret of the session JWT, at least 32 characters (decision 0034). Never commit a real one.
# Generate it with: openssl rand -base64 48
AUTH_JWT_SECRET=dev-only-secret-replace-with-openssl-rand-base64-48
# Lifetime of a session from sign-in, in whole days (decision 0034, R4). Dev default: 90.
AUTH_SESSION_TTL_DAYS=90

# ==== Pairing ====
# Lifetime of an invitation code, in whole hours (decision 0028, R4). Dev default: 48.
PAIRING_INVITATION_CODE_TTL_HOURS=48
