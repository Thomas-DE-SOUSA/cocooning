# ==== API ====
# Base URL of the couple API, reached by the Next server only (server actions), never by the browser.
# Dev default: the local API of docs/guides/local-setup.md. Production: http://api:3100 (docker compose).
API_URL=http://localhost:3100
# Longest wait for an API response, in milliseconds, before the call fails as a network error.
API_TIMEOUT_MS=5000

# ==== Notes ====
# WebSocket of the real-time channel of the notes (decision 0040), opened by the browser with the session cookie.
# Dev default: the local API. Production: wss://<name>.<tailnet>.ts.net/collab, the same origin as the PWA.
NOTES_COLLABORATION_URL=ws://localhost:3100/collab

# NODE_ENV is set by Next.js (development for `next dev`, production for `next build` and `next start`): never set it here.
