{
    "extends": "@cocooning/ts-config/next.json",
    "compilerOptions": {
        "types": ["node", "jest"],
        "paths": { "@/*": ["./src/*"] }
    },
    "include": [
        "next-env.d.ts",
        "next.config.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
