{
    "name": "couple-web",
    "description": "Next.js PWA of the couple domain",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "next build",
        "dev": "next dev -p 3200",
        "start": "next start -p 3200",
        "lint": "eslint . --max-warnings=0",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "test": "jest"
    },
    "dependencies": {
        "@cocooning/couple-shared-kernel": "workspace:*",
        "@cocooning/design-system": "workspace:*",
        "i18next": "catalog:i18n",
