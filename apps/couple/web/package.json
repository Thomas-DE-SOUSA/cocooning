        "react": "catalog:react",
        "react-dom": "catalog:react",
        "react-i18next": "catalog:i18n"
    },
    "devDependencies": {
        "@cocooning/eslint-config": "workspace:*",
        "@cocooning/jest-config": "workspace:*",
        "@cocooning/ts-config": "workspace:*",
        "@tailwindcss/postcss": "catalog:styles",
        "@testing-library/react": "catalog:test",
        "@types/jest": "catalog:test",
        "@types/node": "catalog:build",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "eslint": "catalog:lint",
        "jest": "catalog:test",
        "jest-environment-jsdom": "catalog:test",
        "tailwindcss": "catalog:styles",
        "ts-jest": "catalog:test",
        "typescript": "catalog:build"
    }
