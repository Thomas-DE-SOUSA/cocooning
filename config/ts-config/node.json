{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./base.json",
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "node16",
        "target": "ESNext",
        "declaration": true,
        "types": ["node"],
        "resolveJsonModule": true,
        "incremental": true,
        "skipLibCheck": true,
        "esModuleInterop": true
    }
}
