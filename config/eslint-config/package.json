{
    "name": "@cocooning/eslint-config",
    "description": "Shared ESLint flat configs and the domain boundaries of the monorepo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./base.js",
        "./boundaries": "./boundaries.js",
        "./business-logic": "./business-logic.js",
        "./react": "./react.js",
        "./nest": "./nest.js",
        "./next": "./next.js"
    },
    "scripts": {
        "lint": "eslint . --max-warnings=0",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "test": "jest"
    },
    "dependencies": {
        "@eslint-react/eslint-plugin": "catalog:lint",
        "@eslint/js": "catalog:lint",
        "@next/eslint-plugin-next": "catalog:next",
        "eslint-config-prettier": "catalog:lint",
        "eslint-plugin-boundaries": "catalog:lint",
        "eslint-plugin-react-hooks": "catalog:lint",
        "eslint-plugin-turbo": "catalog:lint",
        "globals": "catalog:lint",
        "typescript-eslint": "catalog:lint"
    },
    "peerDependencies": {
        "eslint": "catalog:lint",
        "typescript": "catalog:build"
    },
    "devDependencies": {
        "@cocooning/jest-config": "workspace:*",
        "@cocooning/ts-config": "workspace:*",
        "@types/jest": "catalog:test",
        "@types/node": "catalog:build",
        "eslint": "catalog:lint",
        "jest": "catalog:test",
        "ts-jest": "catalog:test",
        "turbo": "catalog:tooling",
        "typescript": "catalog:build"
    }
}
