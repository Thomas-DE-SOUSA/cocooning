{
    "$schema": "https://turbo.build/schema.json",
    "ui": "tui",
    "globalEnv": ["NODE_ENV"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*", "src/**", "package.json"],
            "outputs": ["dist/**"]
        },
        "lint": {
            "dependsOn": ["^build"],
            "cache": true
        },
        "check-types": {
            "dependsOn": ["^check-types", "db:generate", "^db:generate"],
            "cache": true
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": ["^build", "db:generate"],
            "cache": true
        },
        "test:watch": {
            "cache": false,
            "persistent": true
        },
        "test:coverage": {
            "dependsOn": ["^build"],
            "cache": true
        },
        "test:mutation": {
            "cache": false
        },
        "test:e2e": {
            "dependsOn": ["^build"],
            "cache": false
        },
        "test:integration": {
            "dependsOn": ["^build", "db:generate"],
            "env": ["DATABASE_POSTGRES_URL"],
            "cache": false
        },
        "db:format": {
            "cache": false
        },
        "db:generate": {
            "cache": true,
            "inputs": [
                "prisma/schema.prisma",
                "prisma/models/**",
                "prisma.config.ts"
            ],
            "outputs": ["src/generated/**"]
        },
        "db:migrate": {
            "cache": false,
            "persistent": true,
            "env": ["DATABASE_POSTGRES_URL"]
        },
        "db:deploy": {
            "cache": false,
            "env": ["DATABASE_POSTGRES_URL"]
        },
        "db:seed": {
            "cache": false,
            "env": ["DATABASE_POSTGRES_URL"]
        },
        "db:reset": {
            "cache": false,
            "env": ["DATABASE_POSTGRES_URL"]
        }
    }
}
