# Secrets of the production stack (infrastructure/compose/docker-compose.prod.yml).
# Copy to infrastructure/compose/.env on the VM; never commit the real file.

# Password of the PostgreSQL user cocooning.
# Generate it with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# HS256 secret of the session JWT, at least 32 characters (decision 0034).
# Generate it with: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-with-openssl-rand-base64-48

# VAPID key pair of the Web Push notifications (R11 of messaging), generated once and kept: a new pair silently
# invalidates every subscribed phone. Generate it with: npx web-push generate-vapid-keys
# The API refuses to start on these placeholders.
WEB_PUSH_VAPID_PUBLIC_KEY=change-me-with-npx-web-push-generate-vapid-keys
WEB_PUSH_VAPID_PRIVATE_KEY=change-me-with-npx-web-push-generate-vapid-keys
# Contact of the sender for the push services: the https address of the PWA.
WEB_PUSH_VAPID_SUBJECT=https://cocooning.<tailnet>.ts.net

# Key of the free Gemini API of the smart folders (decision 0054), created on https://aistudio.google.com/apikey
# with the Google account of Cocooning. Never paste it anywhere else.
NOTE_CARD_GEMINI_API_KEY=change-me-with-a-key-of-aistudio

# Secret of SearXNG, the search engine of the smart folders (decision 0054), used to sign its own pages only.
# Generate it with: openssl rand -hex 32
SEARXNG_SECRET=change-me-with-openssl-rand-hex-32

# Tailscale auth key of the cocooning node: admin console, Settings, Keys,
# "Generate auth key" (not reusable, not ephemeral). Used once: the node state
# then lives in the tailscale-state volume.
TS_AUTHKEY=tskey-auth-change-me

# WebSocket of the real-time channel of the notes, opened by the browser (decision 0040):
# the PWA address with wss and the /collab path, routed to the API by tailscale serve.
NOTES_COLLABORATION_URL=wss://cocooning.<tailnet>.ts.net/collab
