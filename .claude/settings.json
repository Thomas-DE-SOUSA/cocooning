{
    "permissions": {
        "allow": [
            "Edit(_brain/**)",
            "Bash(scripts/check-brain.sh)",
            "Bash(scripts/brain-last-session.sh)",
            "Bash(scripts/brain-last-session.sh *)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(git branch --show-current)",
            "Bash(pnpm lint*)",
            "Bash(pnpm check-types*)",
            "Bash(pnpm test*)",
            "Bash(pnpm build*)",
            "Bash(pnpm format --check*)",
            "Bash(pnpm why *)",
            "Bash(pnpm list*)",
            "Bash(pnpm exec eslint *)",
            "Bash(pnpm exec tsc --noEmit*)",
            "Bash(pnpm exec jest*)",
            "Bash(corepack pnpm@12.21.0 lint*)",
            "Bash(corepack pnpm@12.21.0 check-types*)",
            "Bash(corepack pnpm@12.21.0 test*)",
            "Bash(corepack pnpm@12.21.0 build*)",
            "Bash(corepack pnpm@12.21.0 format --check*)",
            "Bash(npm view *)"
        ],
        "deny": [
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git push * --force*)",
            "Bash(git push * -f*)",
            "Bash(kubectl*)",
            "Bash(rm -rf*)",
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.development)",
            "Read(**/.env.production)",
            "Read(**/.env.test)",
            "Read(**/*.pem)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brain-session-start.sh",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brain-session-end.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brain-stop.sh",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
