{
    "permissions": {
        "allow": [
            "Edit(_brain/**)",
            "Bash(scripts/check-brain.sh)",
            "Bash(scripts/brain-last-session.sh)",
            "Bash(scripts/brain-last-session.sh *)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup|resume|clear|compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brain-session-start.sh",
                        "timeout": 15
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brain-session-end.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/brain-stop.sh",
                        "timeout": 15
                    }
                ]
            }
        ]
    }
}
