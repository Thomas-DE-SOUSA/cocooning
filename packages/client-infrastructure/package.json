{
    "name": "@cocooning/client-infrastructure",
    "description": "Domain-agnostic frontend adapters: the single HTTP client of the gateways",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "lint": "eslint . --max-warnings=0",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "test": "jest"
    },
    "exports": {
        "./shared/http": {
            "types": "./src/shared/http/index.ts",
            "default": "./dist/shared/http/index.js"
        }
    },
    "dependencies": {
        "@cocooning/shared-kernel": "workspace:*",
        "zod": "catalog:validation"
    },
    "devDependencies": {
        "@cocooning/eslint-config": "workspace:*",
        "@cocooning/jest-config": "workspace:*",
        "@cocooning/ts-config": "workspace:*",
        "@types/jest": "catalog:test",
        "@types/node": "catalog:build",
        "eslint": "catalog:lint",
        "jest": "catalog:test",
        "ts-jest": "catalog:test",
        "typescript": "catalog:build"
    }
}
