{
    "name": "@cocooning/design-system",
    "description": "Domain-free UI components and Tailwind tokens of the PWA",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "lint": "eslint . --max-warnings=0",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "test": "jest"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./styles.css": "./src/styles/globals.css"
    },
    "dependencies": {
        "class-variance-authority": "catalog:styles",
        "clsx": "catalog:styles",
        "lucide-react": "catalog:icons",
        "sonner": "catalog:styles",
        "tailwind-merge": "catalog:styles"
    },
    "peerDependencies": {
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "tailwindcss": "catalog:styles"
    },
    "devDependencies": {
        "@cocooning/eslint-config": "workspace:*",
        "@cocooning/jest-config": "workspace:*",
        "@cocooning/ts-config": "workspace:*",
        "@testing-library/react": "catalog:test",
        "@types/jest": "catalog:test",
        "@types/react": "catalog:react",
        "@types/react-dom": "catalog:react",
        "eslint": "catalog:lint",
        "jest": "catalog:test",
        "jest-environment-jsdom": "catalog:test",
        "react": "catalog:react",
        "react-dom": "catalog:react",
        "tailwindcss": "catalog:styles",
        "ts-jest": "catalog:test",
        "typescript": "catalog:build"
    }
}
