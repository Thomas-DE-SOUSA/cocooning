{
    "name": "@cocooning/couple-client-infrastructure",
    "description": "Frontend adapters of the couple bounded contexts: API gateways and their HTTP configuration",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "lint": "eslint . --max-warnings=0",
        "check-types": "tsc --noEmit -p tsconfig.json",
        "test": "jest"
    },
    "exports": {
        "./shared": {
            "types": "./src/shared/index.ts",
            "default": "./dist/shared/index.js"
        }
    },
    "dependencies": {
        "@cocooning/client-infrastructure": "workspace:*",
        "@cocooning/couple-client-business-logic": "workspace:*",
        "@cocooning/couple-contract": "workspace:*"
    },
    "devDependencies": {
        "@cocooning/eslint-config": "workspace:*",
        "@cocooning/jest-config": "workspace:*",
        "@cocooning/ts-config": "workspace:*",
        "@types/jest": "catalog:test",
        "@types/node": "catalog:build",
        "eslint": "catalog:lint",
        "jest": "catalog:test",
        "ts-jest": "catalog:test",
        "typescript": "catalog:build"
    }
}
