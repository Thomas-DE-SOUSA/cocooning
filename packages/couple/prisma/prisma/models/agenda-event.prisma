/// Outbox of the agenda context (decision 0021): written in the transaction of the calendar event, read by the relay.
/// No foreign key to the calendar event: the event outlives it.
model AgendaEvent {
  id          String    @id @db.Uuid
  coupleId    String    @map("couple_id") @db.Uuid
  aggregateId String    @map("aggregate_id") @db.Uuid
  eventName   String    @map("event_name") @db.VarChar(120)
  eventData   Json      @map("event_data") @db.JsonB
  userId      String    @map("user_id") @db.Uuid
  occurredAt  DateTime  @map("occurred_at")
  version     Int       @map("version")
  published   Boolean   @default(false) @map("published")
  publishedAt DateTime? @map("published_at")

  @@unique([aggregateId, version])
  @@index([published, occurredAt])
  @@map("agenda_event")
}
